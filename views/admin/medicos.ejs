<%- include('../partials/header') %>
<% const nomesDias = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb']; %>
<h1>Médicos e grades de atendimento</h1>

<div class="card">
  <h2 class="sem-margem-topo">Médicos cadastrados</h2>
  <% if (!lista.length) { %>
    <div class="vazio">Nenhum médico cadastrado.</div>
  <% } else { %>
    <table>
      <thead><tr><th>Nome</th><th>CRM</th><th>Especialidade</th><th>Dias</th><th>Turno</th><th>Duração</th></tr></thead>
      <tbody>
        <% lista.forEach(m => { %>
          <tr>
            <td><%= m.nome %></td>
            <td><%= m.crm %></td>
            <td><%= m.especialidade %></td>
            <td><%= m.dias.map(d => nomesDias[d]).join(', ') %></td>
            <td><%= m.turnos.map(t => t[0] + '–' + t[1]).join(', ') %></td>
            <td><%= m.duracao %> min</td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<div class="card form">
  <h2 class="sem-margem-topo">Cadastrar novo médico</h2>
  <form method="POST" action="/admin/medicos">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <label for="nome">Nome</label>
    <input id="nome" name="nome" value="<%= valores.nome || '' %>" required>
    <div class="erro-campo"><%= erros.nome || '' %></div>

    <div class="linha">
      <div>
        <label for="crm">CRM</label>
        <input id="crm" name="crm" value="<%= valores.crm || '' %>" required>
        <div class="erro-campo"><%= erros.crm || '' %></div>
      </div>
      <div>
        <label for="especialidade">Especialidade</label>
        <input id="especialidade" name="especialidade" list="lista-especialidades" value="<%= valores.especialidade || '' %>" required>
        <datalist id="lista-especialidades">
          <% especialidades.forEach(e => { %><option value="<%= e %>"></option><% }) %>
        </datalist>
        <div class="erro-campo"><%= erros.especialidade || '' %></div>
      </div>
    </div>

    <label>Dias de atendimento</label>
    <div class="dias-semana">
      <% nomesDias.forEach((n, i) => { %>
        <label class="dia-opcao"><input type="checkbox" name="dias" value="<%= i %>"> <%= n %></label>
      <% }) %>
    </div>
    <div class="erro-campo"><%= erros.dias || '' %></div>

    <div class="linha">
      <div>
        <label for="turnoInicio">Início do turno</label>
        <input id="turnoInicio" name="turnoInicio" type="time" value="<%= valores.turnoInicio || '08:00' %>" required>
      </div>
      <div>
        <label for="turnoFim">Fim do turno</label>
        <input id="turnoFim" name="turnoFim" type="time" value="<%= valores.turnoFim || '12:00' %>" required>
      </div>
    </div>
    <div class="erro-campo"><%= erros.turno || '' %></div>

    <label for="duracao">Duração da consulta (minutos)</label>
    <input id="duracao" name="duracao" type="number" min="10" max="180" step="5" value="<%= valores.duracao || 30 %>" required>
    <div class="erro-campo"><%= erros.duracao || '' %></div>

    <div class="acoes">
      <button class="btn" type="submit">Cadastrar médico</button>
    </div>
  </form>
</div>
<%- include('../partials/footer') %>
